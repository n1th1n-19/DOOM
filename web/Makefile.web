# Browser build. Usage: source ~/emsdk/emsdk_env.sh && make -f Makefile.web
SRC := ../linuxdoom-1.10
SKIP := $(SRC)/i_video.c $(SRC)/i_net.c
CSRC := $(filter-out $(SKIP),$(wildcard $(SRC)/*.c)) i_video_sdl.c i_net_stub.c web_glue.c compose.c
BUILD := build

# -std=gnu89: the 1997 code is K&R-era C; no -DLINUX (it pulls in <values.h>/X11 defaults)
CFLAGS := -O2 -std=gnu89 -DNORMALUNIX -I$(SRC) -sUSE_SDL=2 -w \
	-Wno-error=int-conversion -Wno-error=incompatible-pointer-types
LDFLAGS := -sUSE_SDL=2 -lidbfs.js -sEXPORTED_FUNCTIONS=_main,_Web_SaveConfig \
	-sEXPORTED_RUNTIME_METHODS=FS,ENV,ccall -sALLOW_MEMORY_GROWTH -sSTACK_SIZE=1048576 -sEXIT_RUNTIME=0

OBJS := $(patsubst %.c,$(BUILD)/%.o,$(notdir $(CSRC)))
vpath %.c $(SRC) .

all: $(BUILD)/doom.js
$(BUILD)/doom.js: $(OBJS)
	emcc $(OBJS) -o $@ $(LDFLAGS)
# all objects depend on all headers: the structs are shared (visplane_t etc.)
HDRS := $(wildcard $(SRC)/*.h) $(wildcard *.h)
$(BUILD)/%.o: %.c $(HDRS) | $(BUILD)
	emcc $(CFLAGS) -c $< -o $@
$(BUILD):
	mkdir -p $(BUILD)
clean:
	rm -rf $(BUILD)

# Headless node build for tests: make -f Makefile.web test
# then e.g. DOOM_DUMP=100 DOOM_OUT=/tmp/f.ppm node build/doomtest.js -warp 1 1
TESTOBJS := $(filter-out $(BUILD)/i_video_sdl.o,$(OBJS)) $(BUILD)/i_video_null.o
test: $(BUILD)/doomtest.js
$(BUILD)/doomtest.js: $(TESTOBJS)
	emcc $(TESTOBJS) -o $@ -sUSE_SDL=2 -sALLOW_MEMORY_GROWTH -sSTACK_SIZE=1048576 \
		-sENVIRONMENT=node -sNODERAWFS -sEXIT_RUNTIME=1

# Static site for hosting (Vercel etc.): make -f Makefile.web dist
# then: cd dist && vercel deploy --prod
dist: all
	rm -rf dist
	mkdir -p dist/build
	cp index.html dist/
	cp vercel.dist.json dist/vercel.json
	cp $(BUILD)/doom.js $(BUILD)/doom.wasm dist/build/
	cp -r wads dist/
.PHONY: all clean test dist
